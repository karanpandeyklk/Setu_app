# Setu App - environment template. Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is ignored by git. EXPO_PUBLIC_* values are bundled into the app, so
# treat them as public: never put secrets here.

# Base URL of the Node backend (staging/production value lives in the host env).
EXPO_PUBLIC_API_URL=https://REPLACE-WITH-STAGING-URL

# Google web client ID used by the sign-in flow (public OAuth client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE-WITH-GOOGLE-WEB-CLIENT-ID
